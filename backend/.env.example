# Copy this file to  .env  (same folder) and fill in your values.
# backend/config/settings.py loads it automatically on startup.

# --- Invoice Scan Inbox (OCR) ---
# Required for the Scan Inbox to actually read invoices. Get a key from
# https://aistudio.google.com/apikey  (Google AI Studio, free tier available).
# Without this, scanning will upload the file but cannot extract data.
GEMINI_API_KEY=

# Optional: use Anthropic Claude vision instead of Gemini.
# AI_SCAN_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# --- Optional overrides (defaults are fine for local use) ---
# DEBUG=True
# SECRET_KEY=change-me
# DB_ENGINE=sqlite3
